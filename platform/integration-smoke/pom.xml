<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.reactor</groupId>
        <artifactId>rust-java-platform-parent</artifactId>
        <version>4.2.0</version>
        <relativePath>../parent/pom.xml</relativePath>
    </parent>

    <artifactId>rust-java-platform-integration-smoke</artifactId>
    <name>Rust-Java Platform Integration Smoke</name>

    <properties>
        <maven.install.skip>true</maven.install.skip>
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.reactor</groupId>
            <artifactId>rust-java-starter-rest</artifactId>
        </dependency>
        <dependency>
            <groupId>com.reactor</groupId>
            <artifactId>rust-java-starter-openapi</artifactId>
        </dependency>
        <dependency>
            <groupId>com.reactor</groupId>
            <artifactId>rust-java-starter-dubbo</artifactId>
        </dependency>
        <dependency>
            <groupId>com.reactor</groupId>
            <artifactId>rust-java-starter-cache-reader</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>com.reactor</groupId>
                <artifactId>rust-java-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>verify-aot</id>
                        <goals><goal>verify-aot</goal></goals>
                        <configuration>
                            <requireRoutes>true</requireRoutes>
                            <requireOpenApi>true</requireOpenApi>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
