<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.reactor</groupId>
    <artifactId>rust-java-platform-parent</artifactId>
    <version>4.6.1</version>
    <packaging>pom</packaging>
    <name>Rust-Java Platform Parent</name>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <rust-java-rest.version>4.6.1</rust-java-rest.version>
        <java-rust-dubbo.version>0.7.3</java-rust-dubbo.version>
        <java-rust-cache.version>0.7.6</java-rust-cache.version>
        <dsl-json.version>2.0.2</dsl-json.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.reactor</groupId>
                <artifactId>rust-java-platform-bom</artifactId>
                <version>${rust-java-rest.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.2</version>
                </plugin>
                <plugin>
                    <groupId>com.reactor</groupId>
                    <artifactId>rust-java-maven-plugin</artifactId>
                    <version>${rust-java-rest.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>com.dslplatform</groupId>
                            <artifactId>dsl-json</artifactId>
                            <version>${dsl-json.version}</version>
                        </path>
                        <path>
                            <groupId>com.reactor</groupId>
                            <artifactId>rust-java-rest</artifactId>
                            <version>${rust-java-rest.version}</version>
                            <classifier>codegen</classifier>
                        </path>
                        <path>
                            <groupId>com.reactor</groupId>
                            <artifactId>java-rust-dubbo</artifactId>
                            <version>${java-rust-dubbo.version}</version>
                            <classifier>codegen</classifier>
                        </path>
                        <path>
                            <groupId>com.reactor</groupId>
                            <artifactId>java-rust-cache</artifactId>
                            <version>${java-rust-cache.version}</version>
                            <classifier>codegen</classifier>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.reactor</groupId>
                <artifactId>rust-java-maven-plugin</artifactId>
                <version>${rust-java-rest.version}</version>
                <executions>
                    <execution>
                        <id>reactor-doctor</id>
                        <goals><goal>doctor</goal></goals>
                    </execution>
                    <execution>
                        <id>verify-aot</id>
                        <goals><goal>verify-aot</goal></goals>
                    </execution>
                    <execution>
                        <id>verify-native-abi</id>
                        <goals><goal>verify-native-abi</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
