<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.reactor</groupId>
    <artifactId>rust-java-rest</artifactId>
    <version>4.4.1</version>
    <name>Rust-Java REST Framework</name>
    <description>Low-latency REST API framework with Rust Hyper HTTP I/O, Java handlers, low-RSS runtime profiles, route admission, and native response paths</description>


    <url>https://github.com/esasmer-dou/rust-java-rest</url>
    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>esasmer-dou</id>
            <name>Mustafa</name>
            <email>mustafakorkmz@gmail.com</email>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:git://github.com/esasmer-dou/rust-java-rest.git</connection>
        <developerConnection>scm:git:ssh://github.com:esasmer-dou/rust-java-rest.git</developerConnection>
        <url>https://github.com/esasmer-dou/rust-java-rest</url>
    </scm>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven-compiler-plugin-version>3.12.1</maven-compiler-plugin-version>
        <maven-jar-plugin-version>3.3.0</maven-jar-plugin-version>
        <maven-shade-plugin-version>3.5.1</maven-shade-plugin-version>
        <jakarta.annotation-api-version>2.1.1</jakarta.annotation-api-version>
        <maven-source-plugin-version>3.3.0</maven-source-plugin-version>
        <maven-javadoc-plugin-version>3.6.3</maven-javadoc-plugin-version>
    </properties>

    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/esasmer-dou/rust-java-rest</url>
        </repository>
    </distributionManagement>

    <dependencies>

        <!-- DSL-JSON 2.0.2 - Compile-time JSON serialization (ZERO runtime reflection) -->
        <dependency>
            <groupId>com.dslplatform</groupId>
            <artifactId>dsl-json</artifactId>
            <version>2.0.2</version>
        </dependency>

        <!-- Jakarta Annotations (minimal overhead, optional) -->
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
            <version>${jakarta.annotation-api-version}</version>
        </dependency>

        <!-- JUnit 5 for testing -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>copy-codegen-services</id>
                        <phase>prepare-package</phase>
                        <goals><goal>copy-resources</goal></goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/codegen-classes</outputDirectory>
                            <resources>
                                <resource><directory>src/codegen/resources</directory></resource>
                            </resources>
                        </configuration>
                    </execution>
                    <execution>
                        <id>copy-codegen-classes</id>
                        <phase>prepare-package</phase>
                        <goals><goal>copy-resources</goal></goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/codegen-classes</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.build.outputDirectory}</directory>
                                    <includes>
                                        <include>com/reactor/rust/codegen/**</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Compiler Plugin with DSL-JSON annotation processor -->
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin-version}</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <release>${java.version}</release>
                    <annotationProcessorPaths>
                        <!-- DSL-JSON annotation processor for compile-time code generation -->
                        <path>
                            <groupId>com.dslplatform</groupId>
                            <artifactId>dsl-json</artifactId>
                            <version>2.0.2</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!-- Jar Plugin - the default published artifact is the lean production framework jar. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>${maven-jar-plugin-version}</version>
                <executions>
                    <execution>
                        <id>default-jar</id>
                        <configuration>
                            <excludes>
                                <exclude>com/reactor/rust/codegen/**</exclude>
                                <exclude>com/reactor/rust/example/**</exclude>
                                <exclude>com/reactor/rust/benchmark/**</exclude>
                                <exclude>com/reactor/rust/dubbo/sample/**</exclude>
                                <exclude>META-INF/reactor/**</exclude>
                                <exclude>META-INF/services/javax.annotation.processing.Processor</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                    <execution>
                        <id>codegen-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classifier>codegen</classifier>
                            <classesDirectory>${project.build.directory}/codegen-classes</classesDirectory>
                            <includes>
                                <include>com/reactor/rust/codegen/**</include>
                                <include>META-INF/services/javax.annotation.processing.Processor</include>
                            </includes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Shade Plugin - optional lean production runtime artifact. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>${maven-shade-plugin-version}</version>
                <executions>
                    <execution>
                        <id>attach-core-runtime</id>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>core-runtime</shadedClassifierName>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>${project.groupId}:${project.artifactId}</artifact>
                                    <excludes>
                                        <exclude>com/reactor/rust/codegen/**</exclude>
                                        <exclude>com/reactor/rust/example/**</exclude>
                                        <exclude>com/reactor/rust/benchmark/**</exclude>
                                        <exclude>com/reactor/rust/dubbo/sample/**</exclude>
                                        <exclude>META-INF/reactor/**</exclude>
                                        <exclude>META-INF/services/javax.annotation.processing.Processor</exclude>
                                    </excludes>
                                </filter>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>com/dslplatform/json/processor/**</exclude>
                                        <exclude>META-INF/services/javax.annotation.processing.Processor</exclude>
                                        <exclude>META-INF/gradle/incremental.annotation.processors</exclude>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Surefire Plugin for running tests -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>verify-codegen-artifact-boundary</id>
                        <phase>verify</phase>
                        <goals><goal>java</goal></goals>
                        <configuration>
                            <mainClass>com.reactor.rust.codegen.ArtifactLayoutVerifier</mainClass>
                            <arguments>
                                <argument>${project.build.directory}/${project.build.finalName}.jar</argument>
                                <argument>${project.build.directory}/${project.build.finalName}-codegen.jar</argument>
                                <argument>com/reactor/rust/codegen/</argument>
                                <argument>${project.build.directory}/${project.build.finalName}-core-runtime.jar</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Source Plugin for publishing sources -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>${maven-source-plugin-version}</version>
                <configuration>
                    <excludes>
                        <exclude>com/reactor/rust/codegen/**</exclude>
                        <exclude>com/reactor/rust/example/**</exclude>
                        <exclude>com/reactor/rust/benchmark/**</exclude>
                        <exclude>com/reactor/rust/dubbo/sample/**</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Javadoc Plugin for publishing javadoc -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>${maven-javadoc-plugin-version}</version>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <doclint>none</doclint>
                    <quiet>true</quiet>
                    <excludePackageNames>
                        com.reactor.rust.codegen:com.reactor.rust.codegen.*:com.reactor.rust.example:com.reactor.rust.example.*:com.reactor.rust.benchmark:com.reactor.rust.benchmark.*:com.reactor.rust.dubbo.sample:com.reactor.rust.dubbo.sample.*
                    </excludePackageNames>
                    <additionalOptions>
                        <additionalOption>--add-modules=java.net.http,java.management,java.compiler</additionalOption>
                        <additionalOption>--add-reads=jakarta.annotation=java.management</additionalOption>
                        <additionalOption>--add-reads=jakarta.annotation=java.compiler</additionalOption>
                    </additionalOptions>
                    <sourceFileExcludes>
                        <sourceFileExclude>**/_*DslJsonConverter.java</sourceFileExclude>
                        <sourceFileExclude>**/*DslJsonConverter.java</sourceFileExclude>
                    </sourceFileExcludes>
                </configuration>
            </plugin>

        </plugins>
    </build>

</project>
